<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MonkMode.Tests - pure unit tests for the tamper-critical logic.

    C#, not VB, deliberately: VB namespaces are case-insensitive, so the CLI's
    root namespace `MonkMode` and the service's `monkmode` merge in a VB test
    project and their duplicated Simple3Des/IniFile types become ambiguous.
    C# keeps them distinct.

    HARD FENCE: these tests must never touch the real hosts file, the registry,
    or the service - in-memory strings and the test bin directory only.
  -->

  <PropertyGroup>
    <!-- D4b: matched to MM_notify's versioned TFM. MM_notify now targets
         net8.0-windows10.0.17763.0 (WinRT toast APIs); a project on the default net8.0-windows
         (platform 7.0) CANNOT reference one on 10.0.17763, so this consumer is bumped to match.
         The other three referenced projects stay on plain net8.0-windows - a higher-platform
         consumer referencing lower-platform dependencies is allowed (only the reverse fails).
         The tests remain pure: no WinRT is called from here (the versioned TFM only widens what
         COULD be reached, it changes no existing test). -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MonkMode\MonkMode.vbproj" />
    <ProjectReference Include="..\MonkMode_srv\MonkMode_srv\MonkMode_srv.vbproj" />
    <ProjectReference Include="..\MM_notify\MM_notify\MM_notify.vbproj" />
    <ProjectReference Include="..\MM_guard\MM_guard\MM_guard.vbproj" />
  </ItemGroup>

</Project>
