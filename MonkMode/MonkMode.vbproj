<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <MyType>Empty</MyType>
    <RootNamespace>MonkMode</RootNamespace>
    <AssemblyName>monkmode</AssemblyName>
    <StartupObject>MonkMode.Program</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>My Project\app.manifest</ApplicationManifest>
    <ApplicationIcon>monkmode_icon.ico</ApplicationIcon>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <!-- #10 (audit P3): TRACE off in all configs - the inherited IniFile Trace.WriteLine
         calls echo the DPAPI [Integrity] Key/Mac + 3DES ciphertext to OutputDebugString
         (DebugView-capturable) on every config read/write; TRACE is on by default in
         Release. Off here compiles those calls out entirely. -->
    <DefineTrace>false</DefineTrace>
    <NoWarn>42016,41999,42017,42018,42019,42032,42036,42020,42021,42022</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Diagnostics" />
  </ItemGroup>

  <!--
    Deploy-gap visibility: generate the BuildStamp module from the SourceRevisionId /
    MonkModeBuiltUtc properties (defaults + rationale in the repo-root
    Directory.Build.props). GenerateAssemblyInfo is false in this project, so assembly
    attributes are not an option; a generated source file is.

    WriteOnlyWhenDifferent keeps incremental builds clean - the content only changes when
    the commit (or an explicitly passed build instant) changes, so a plain `dotnet build`
    recompiles this project no more often than it did before.

    No namespace is declared in the generated file: RootNamespace is MonkMode, so a bare
    module lands at MonkMode.BuildStamp (declaring one would give MonkMode.MonkMode).
  -->
  <Target Name="StampBuildInfo" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <MonkModeBuildStampFile>$(IntermediateOutputPath)MonkModeBuildStamp.g.vb</MonkModeBuildStampFile>
    </PropertyGroup>
    <ItemGroup>
      <MonkModeBuildStampLines Include="' &lt;auto-generated&gt; Written by MonkMode.vbproj's StampBuildInfo target. Do not edit." />
      <MonkModeBuildStampLines Include="Friend Module BuildStamp" />
      <MonkModeBuildStampLines Include="    Friend Const Revision As String = &quot;$(SourceRevisionId)&quot;" />
      <MonkModeBuildStampLines Include="    Friend Const BuiltUtc As String = &quot;$(MonkModeBuiltUtc)&quot;" />
      <MonkModeBuildStampLines Include="End Module" />
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(MonkModeBuildStampFile)"
                      Lines="@(MonkModeBuildStampLines)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(MonkModeBuildStampFile)" />
      <FileWrites Include="$(MonkModeBuildStampFile)" />
    </ItemGroup>
  </Target>

</Project>
