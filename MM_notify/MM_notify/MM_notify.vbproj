<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- D4b: Windows-versioned TFM (10.0.17763 = Win10 1809, the toolkit's floor) so the
         WinRT projections (Windows.UI.Notifications.ToastNotificationManager /
         Windows.Data.Xml.Dom) AND Microsoft.Toolkit.Uwp.Notifications' send/manage APIs
         (ToastNotificationManagerCompat.Show) are present - without them a toast can only be
         BUILT, never delivered. This is the notifier ONLY: the CLI, service and guardian stay
         on plain net10.0-windows (they show no toasts), so dist\ / publish is unaffected. The
         test project is bumped to the SAME versioned TFM (it references this assembly; a lower
         platform version can't reference a higher one). SDK.BuildTools-free path: the .NET 10 SDK
         supplies the 10.0.17763 ref pack automatically, no extra install. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <StartupObject>mm_notify.Program</StartupObject>
    <RootNamespace>mm_notify</RootNamespace>
    <AssemblyName>mm_notify</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <!-- #10 (audit P3): TRACE off in all configs - the inherited IniFile Trace.WriteLine
         calls echo the DPAPI [Integrity] Key/Mac + 3DES ciphertext to OutputDebugString
         (DebugView-capturable) on every config read/write; TRACE is on by default in
         Release. Off here compiles those calls out entirely. -->
    <DefineTrace>false</DefineTrace>
    <NoWarn>42016,41999,42017,42018,42019,42032,42036,42020,42021,42022</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <!-- D4b: persistent Action-Centre toasts for an UNPACKAGED WinForms exe. This package
         (MIT, GPLv3-compatible, free) is Microsoft's documented route for Win32 non-MSIX apps:
         ToastNotificationManagerCompat lazily + idempotently registers the AUMID, a per-user
         Start-menu shortcut, and an HKCU COM activator on the FIRST CreateToastNotifier() call -
         all at RUNTIME inside the notifier only, never at build or in the pure unit tests. -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
